# DB 연결 URL
DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME

# JWT 시크릿 키 (랜덤 문자열)
SECRET_KEY=your-secret-key-here

# Claude API 키 (https://console.anthropic.com)
CLAUDE_API_KEY=sk-ant-...

# 카카오 REST API 키
KAKAO_REST_KEY=your-kakao-rest-key
KAKAO_REDIRECT_URI=http://localhost:5173/kakao/callback
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# 구글 OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/google/callback

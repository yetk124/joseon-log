# 백엔드 API 서버 URL
VITE_API_URL=http://localhost:8000

# 카카오맵 JavaScript 앱 키
VITE_KAKAO_MAP_KEY=your-kakao-map-key

# 카카오 OAuth REST API 키
VITE_KAKAO_REST_KEY=your-kakao-rest-key
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/kakao/callback

# 구글 OAuth 클라이언트 ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/google/callback
